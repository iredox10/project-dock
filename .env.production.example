# Production Environment Variables
# Copy this to .env for production deployment

# ========================================
# PAYSTACK (LIVE MODE)
# ========================================
VITE_PAYSTACK_PUBLIC_KEY=pk_live_your_actual_live_key_here
VITE_APPWRITE_PAYSTACK_FUNCTION_ID=your_paystack_function_id
VITE_PAYSTACK_DEMO_MODE=false

# ========================================
# APPWRITE
# ========================================
VITE_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT_ID=your_production_project_id
VITE_APPWRITE_DATABASE_ID=your_production_database_id

# ========================================
# GEMINI AI
# ========================================
VITE_GEMINI_API_KEY=your_production_gemini_api_key

# ========================================
# IMPORTANT PRODUCTION NOTES
# ========================================
# 1. Use LIVE Paystack key (pk_live_...)
# 2. Set DEMO_MODE to false
# 3. Use production Appwrite project
# 4. Never commit this file to git
# 5. Test thoroughly before going live
# 6. Monitor transactions on Paystack dashboard
