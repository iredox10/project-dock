# Gemini AI API Key
# Get your free API key from: https://makersuite.google.com/app/apikey
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Appwrite Configuration
# Get your Appwrite credentials from: https://console.appwrite.io/
VITE_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT_ID=your_project_id_here
VITE_APPWRITE_DATABASE_ID=your_database_id_here

# OPay Payment Gateway Configuration
# Get your credentials from: https://merchant.opayweb.com/
VITE_OPAY_MERCHANT_ID=your_opay_merchant_id
VITE_OPAY_PUBLIC_KEY=your_opay_public_key
VITE_OPAY_PRIVATE_KEY=your_opay_private_key
VITE_OPAY_ENV=sandbox
# Change to 'production' when ready to go live

# Demo Mode (for testing without OPay credentials)
VITE_OPAY_DEMO_MODE=true
# Set to 'false' when you have real OPay credentials

# Paystack Payment Gateway Configuration
# Get your credentials from: https://dashboard.paystack.com/settings/developer
VITE_PAYSTACK_PUBLIC_KEY=pk_test_your_public_key_here
VITE_APPWRITE_PAYSTACK_FUNCTION_ID=your_paystack_function_id_here
# Demo Mode for testing payment without Paystack credentials
VITE_PAYSTACK_DEMO_MODE=true
# Set to 'false' when you have real Paystack credentials
